{
  "name": "@isqrd/better-diagrams",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test:unit": "node --test test/*.test.ts",
    "build": "node scripts/build.mjs",
    "pack:skill": "npm run build && node scripts/package-skill.mjs",
    "prepack": "npm run build",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/semver": "7.8.0",
    "elkjs": "0.12.0",
    "esbuild": "0.28.2",
    "semver": "7.8.5",
    "typescript": "7.0.2"
  },
  "bin": {
    "better-diagrams": "dist/cli.mjs"
  },
  "description": "Interactive software diagrams with automatic layout and local browser editing.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ruohao1/better-diagrams.git"
  },
  "files": [
    "dist/cli.mjs",
    "dist/viewer.js",
    "dist/editor.js",
    "dist/licenses/",
    "plugin.json",
    "skills/",
    "examples/",
    "README.md",
    "CHANGELOG.md"
  ]
}
